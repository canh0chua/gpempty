<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@color/control_gray"
        android:elevation="4dp">

        <!-- Row 1: Top Panel (Logs - Start - Contact) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Logs Button (Left) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_show_logs"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:icon="@drawable/ic_logs"
                app:iconSize="28dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                android:backgroundTint="#546E7A"
                app:cornerRadius="16dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:rippleColor="#FFFFFF" />

            <!-- Start/Stop Button (Center) -->
            <Button
                android:id="@+id/btn_start_stop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="#4CAF50"
                android:text="Start"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="4dp" />

            <!-- Contact Button (Right) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_contact"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:icon="@drawable/ic_contact"
                app:iconSize="28dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                android:backgroundTint="#455A64"
                app:cornerRadius="16dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:rippleColor="#FFFFFF" />
        </LinearLayout>

        <!-- Row 2: Delete Mode + Skip Days -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <RadioGroup
                android:id="@+id/rg_delete_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skip"
                    android:textColor="@color/white"
                    android:buttonTint="@color/white"
                    android:checked="true"
                    android:minHeight="32dp" />

                <RadioButton
                    android:id="@+id/rb_delete_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textColor="@color/white"
                    android:buttonTint="@color/white"
                    android:layout_marginStart="12dp"
                    android:minHeight="32dp" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/ll_skip_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tv_skip_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1d"
                    android:textColor="@color/text_hint"
                    android:layout_marginEnd="4dp" />
                
                <SeekBar
                    android:id="@+id/sb_skip_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="14"
                    android:progress="0"
                    android:thumbTint="@color/white"
                    android:progressTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: Auto Cleaning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Switch
                android:id="@+id/sw_auto_run_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:thumbTint="@color/white"
                android:trackTint="#888888" 
                android:minHeight="32dp"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Cleaning"
                android:textColor="@color/white"
                android:layout_marginStart="8dp"
                android:textSize="14sp"/>

            <Spinner
                android:id="@+id/sp_run_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="32dp"
                android:backgroundTint="@color/white" />
                
            <TextView
                android:id="@+id/tv_runs_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0/4"
                android:gravity="end"
                android:textColor="#888888" 
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Row 4: Scheduling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Switch
                android:id="@+id/sw_schedule_9pm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:thumbTint="@color/white"
                android:trackTint="#888888"
                android:minHeight="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Cleaning at 9PM"
                android:textColor="@color/white"
                android:layout_marginStart="8dp"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tv_next_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Next: --:--"
                android:gravity="end"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <WebView
        android:id="@+id/automation_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
